# Copy this file to .env and fill in any API keys you use.
SERPER_KEY=
TWITTER_BEARER=

# Required for owner-only refresh controls. Generate a long random secret.
OWNER_TOKEN=
# Use an independent random secret for signed owner sessions in production.
APP_SECRET_KEY=
# Set true when serving over HTTPS; leave false for local development only.
SESSION_COOKIE_SECURE=false
